# WireGuard private key for Nord: curl -s -u token:<access token> https://api.nordvpn.com/v1/users/services/credentials  (field nordlynx_private_key)
WIREGUARD_PRIVATE_KEY=
# Gluetun control API key (openssl rand -hex 24); the panel uses it to switch country and stop/start the VPN
GLUETUN_API_KEY=
# optional
VPN_COUNTRY=United Kingdom
